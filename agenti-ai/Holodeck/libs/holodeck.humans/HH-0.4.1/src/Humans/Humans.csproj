<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Person</AssemblyName>
    <RootNamespace>Humans</RootNamespace>
    <!-- The agent image has no ICU; the agent formats no culture-specific text. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Humans.Tests" />
    <ProjectReference Include="../Humans.Prompts/Humans.Prompts.csproj" />
  </ItemGroup>
</Project>
