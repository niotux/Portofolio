<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="PrimordialPower.Lab.MainWindow"
  Title="PrimordialPower Lab"
  Width="1400" Height="900"
  Background="#000000"
>
  <Canvas>
    <Border x:Name="WorkerWindow" Canvas.Left="100" Canvas.Top="100" Width="400" Height="300" Background="#1b1b1b" BorderBrush="#333333" BorderThickness="2">
      <DockPanel>
        <Border x:Name="WorkerWindow_TitleBar" DockPanel.Dock="Top" Background="#202020" Height="30">
          <TextBlock Text="Worker" Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
        </Border>
        <Border Background="#000000">
          <TextBlock Text="Content goes here" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
      </DockPanel>
    </Border>
  </Canvas>
</Window>