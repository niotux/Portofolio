// PLANET - FRAGMENT SHADER
#version 460 core

in vec3 normal;
in vec3 fragPos;
in vec2 texCoord;

uniform sampler2D Texture;
uniform vec3 lightDirection;
uniform vec3 cameraPos;

out vec4 fragColor;

void main()
{
    vec3 lightDir = normalize(lightDirection);
    vec3 viewDir = normalize(cameraPos - fragPos);

    vec3 halfVector = normalize(lightDir + viewDir);

    // Lights
    float diffuseLight = max(dot(normal, lightDirection), 0.0f);
    float specularLight = pow(max(dot(halfVector, normal), 0.0f), 32);

    vec4 textureColor = texture(Texture, texCoord);
    vec4 diffuseColor = textureColor * diffuseLight;
    vec4 specularColor = vec4(1.0) * specularLight * 0.1;

    fragColor = diffuseColor + specularColor;
    fragColor.a = 0.2;
}