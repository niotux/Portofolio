{
  "Name": "lan2llvm",
  "Dependencies": [
    {
      "Path": "../lan",
      "Module": "c",
      "On": [
        {
          "Tool": "build",
          "Option": "-dylib"
        }
      ]
    },
    {
      "Path": "../clikit",
      "Module": "c",
      "On": [
        {
          "Tool": "build",
          "Option": "-dylib"
        }
      ]
    }
  ],
  "Source": "",
  "OutputBase": "bin",
  "Output": "$EMPIRE_CONFIG-$EMPIRE_RID/",
  "Artefacts": "$EMPIRE_CONFIG-$EMPIRE_RID/obj/",
  "Configs": [
    {
      "Name": "debug",
      "Flags": "-g -O0 -DDEBUG"
    },
    {
      "Name": "release",
      "Flags": "-O2 -DNDEBUG"
    }
  ]
}
